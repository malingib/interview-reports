# Set true only after configuring abuse protection and usage limits for your deployment.
AI_ENABLED=false

# Server-only provider configuration. Never prefix these with NEXT_PUBLIC_.
# Platform AI uses AI_DEFAULT_PROVIDER. No automatic fallback is performed.
AI_DEFAULT_PROVIDER=gemini

# Configure only the providers you intend to offer:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
